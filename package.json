{
  "name": "tearush-app",
  "version": "1.0.0",
  "description": "TeaRush — milk tea ordering app (Ionic + Angular + Capacitor) with PayMongo payments",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "cap:sync": "ng build && cap sync android",
    "android:open": "cap open android",
    "apk": "node scripts/build-android.mjs debug",
    "apk:release": "node scripts/build-android.mjs release",
    "aab": "node scripts/build-android.mjs bundle"
  },
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@ionic/angular": "^8.8.19",
    "ionicons": "^8.0.13",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.25",
    "@capacitor/cli": "^8.5.3",
    "typescript": "~5.9.3"
  }
}
