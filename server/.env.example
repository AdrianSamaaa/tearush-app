# Copy this file to `.env` and fill in the values.
# On Render/Railway/etc. set these as environment variables instead.

# --- Server ---
PORT=3000
# Public base URL of this server (no trailing slash). PayMongo redirects the
# customer's browser here after payment, so the phone must be able to reach it.
#   Deployed:          https://tearush-api.onrender.com
#   Local + emulator:  http://10.0.2.2:3000
#   Local + real phone on same Wi-Fi: http://<your-PC-LAN-IP>:3000
PUBLIC_URL=http://localhost:3000
# Where the SQLite database file is stored.
DATA_DIR=./data
# Long random string used to sign login tokens. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Admin account (created on first start if it doesn't exist) ---
ADMIN_EMAIL=admin@tearush.app
ADMIN_PASSWORD=
ADMIN_NAME=TeaRush Admin

# --- Email (verification codes) ---
# Any SMTP server works. Gmail: turn on 2-Step Verification, create an App Password
# (Google Account → Security → App passwords) and use:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TeaRush <you@gmail.com>
# Without SMTP, codes are shown in the app during development. Set to true to also do that
# in production (handy for demos — not secure for a real shop).
EMAIL_DEMO_MODE=false

# --- PayMongo (https://dashboard.paymongo.com/developers) ---
# Use the TEST keys (sk_test_...) while developing. Never put the secret key in the mobile app.
PAYMONGO_SECRET_KEY=
# Shown once when you create the webhook (whsk_...). Run `npm run webhook:register` to create it.
PAYMONGO_WEBHOOK_SECRET=
# Payment methods the app offers (must be enabled on your PayMongo account).
PAYMONGO_METHODS=gcash,paymaya,card,grab_pay

# Custom URL scheme of the Android app, used to jump back into the app after paying.
APP_SCHEME=tearush
